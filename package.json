{
  "name": "pixelcoords-site",
  "version": "0.1.0",
  "private": true,
  "description": "The promo and search site for pixelcoords \u2014 freeze your screen, mark regions, get machine-usable coordinates.",
  "author": {
    "name": "Nolin Naidoo",
    "email": "nolin.naidoo@me.com",
    "url": "https://github.com/nolindnaidoo"
  },
  "license": "MIT",
  "homepage": "https://pixelcoords.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nolindnaidoo/pixelcoords-site.git"
  },
  "bugs": {
    "url": "https://github.com/nolindnaidoo/pixelcoords-site/issues"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "lighthouse": "lhci autorun",
    "budget": "bun scripts/check-bundle-budget.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@happy-dom/global-registrator": "^20.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest-axe": "^11.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
