---
import CoordChip from '@/components/CoordChip.astro'

// The tool's own loop, from docs/CLI.md: mark → assert → emit → find →
// resume. Each beat shows the command and a real (condensed) artifact.
const BEATS = [
  {
    step: '01',
    command: 'pixelcoords',
    line: 'Freeze, mark, save a session.',
    artifact: `{ "schema": 1,
  "selections": [{ "shape": "rect", "label": "submit",
    "px": { "x": 812, "y": 440, "w": 96, "h": 40 } }] }`,
  },
  {
    step: '02',
    command: 'pixelcoords assert --point 812,440 --expect submit',
    line: 'Score points against it. The exit code is the API: 0 hit, 1 miss, 2 malformed.',
    artifact: `{ "command": "assert", "ok": true,
  "results": [{ "hit": true, "space": "global" }] }   # exit 0`,
  },
  {
    step: '03',
    command: 'pixelcoords resolve --label submit --units auto',
    line: 'Where to click now, in the units your input API wants — per monitor scale.',
    artifact: `{ "label": "submit", "scale": 2.0, "units": "logical",
  "point": { "x": 406, "y": 230 } }`,
  },
  {
    step: '04',
    command: 'pixelcoords emit --format pyautogui',
    line: 'Click code in the target tool’s own coordinate convention.',
    artifact: `pyautogui.click(812, 460)  # submit`,
  },
  {
    step: '05',
    command: 'pixelcoords wait --label dialog --for match',
    line: 'Block until the region is back on screen; exit 1 if it never arrives.',
    artifact: `{ "ok": true, "polls": 7, "elapsed_ms": 3204,
  "results": [{ "score": 0.997, "matching": true }] }`,
  },
  {
    step: '06',
    command: 'pixelcoords diff --against baseline/',
    line: 'Did those regions still look right? Visual regression, per region.',
    artifact: `{ "masked_px": 400, "changed_px": 3,
  "changed_pct": 0.75, "mean_delta": 172.67 }`,
  },
  {
    step: '07',
    command: 'pixelcoords find',
    line: 'The UI drifted? Every region re-located by its saved crop.',
    artifact: `{ "found": true, "score": 0.998,
  "delta": { "dx": 0, "dy": -120 } }`,
  },
  {
    step: '08',
    command: 'pixelcoords resume',
    line: 'Reopen any session and keep editing; saves update it in place.',
    artifact: `session.json  screenshot-0.png  crop-0-submit.png  → editable again`,
  },
] as const
---

<section class="flex flex-col gap-4">
      <h2 class="flex items-center gap-3 text-2xl font-semibold">
        <CoordChip ariaHidden tone="preview">
          loop
        </CoordChip>
        The tool is a loop
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {BEATS.map(beat => (
          <div
            class="flex min-w-0 flex-col gap-2 rounded-lg border border-border-token bg-surface p-4"
          >
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-xs text-target">{beat.step}</span>
              <code class="min-w-0 break-all font-mono text-sm text-foreground">
                {beat.command}
              </code>
            </div>
            <p class="text-sm text-foreground/70 dark:text-foreground/55">{beat.line}</p>
            {/* The expression hugs the tags: `pre` preserves whitespace, so a
                newline and the source indentation would render as a first-line
                indent that nothing in the data asked for. */}
            <pre
              role="group"
              tabindex="0"
              aria-label={`${beat.command} output`}
              class="overflow-x-auto rounded bg-background p-2 font-mono text-xs leading-5 text-committed"
            >{beat.artifact}</pre>
          </div>
        ))}
      </div>
    </section>
